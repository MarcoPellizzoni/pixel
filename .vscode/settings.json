{
  // Pylance is the VS Code build of the very same analysis engine the command
  // line runs as Pyright. It reads its rules straight from [tool.pyright] in
  // pyproject.toml, which is therefore the single place to change them: editor
  // and terminal cannot diverge.
  //
  // Note that `python.analysis.typeCheckingMode` and `python.analysis.extraPaths`
  // are deliberately absent: Pylance ignores them as soon as a pyproject.toml
  // carries a [tool.pyright] section, and setting them here would only look like
  // configuration that does nothing.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.languageServer": "Pylance",

  // Shows the inferred types next to the code: useful on a fully annotated
  // codebase, because it makes it immediately visible where a type gets lost.
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.functionReturnTypes": true,

  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  }
}
